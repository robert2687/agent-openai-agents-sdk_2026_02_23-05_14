# Copy this file to .env and fill in the backend you want to use.
# Local/OpenAI mode works without Databricks.

# Backend selection
AGENT_BACKEND=openai
AGENT_MODEL=gpt-4.1-mini
AGENT_FALLBACK_MODEL=gpt-4.1
AGENT_MAX_RETRIES=2
AGENT_RETRY_BASE_SECONDS=1.0

# Local/OpenAI credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=

# App identity
APP_NAME=PERFECT-AGENT
APP_URL=https://github.com/robert2687

# Local MLflow defaults
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT_ID=

# Optional Databricks settings
# Switch AGENT_BACKEND=databricks and fill one auth method below.
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Networking
API_PORT=8000
UI_PORT=7860
